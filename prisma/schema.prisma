generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  WAITING_JOKI
  ASSIGNED
  IN_PROGRESS
  PAUSED
  QC
  COMPLETED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum LoginMethod {
  MOONTON
  GOOGLE
  FACEBOOK
  TIKTOK
  OTHER
}
enum PaymentProvider {
  DOKU
}

enum PaymentMethod {
  QRIS
}

enum PaymentAttemptStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}


enum ServiceMode {
  ACCOUNT
  GENDONG
}

enum OrderEventType {
  ORDER_CREATED
  STATUS_CHANGED
  PAYMENT_UPDATED
  PROGRESS_UPDATED
  CREDENTIALS_RECEIVED
}

enum AdminAuditAction {
  ADMIN_LOGIN_SUCCESS
  ADMIN_LOGIN_FAILED
  PAYMENT_MARKED_PAID
  ORDER_STATUS_CHANGED
  ORDER_PROGRESS_UPDATED
  CREDENTIAL_REVEALED
  JOKI_CREATED
  JOKI_UPDATED
  JOKI_ASSIGNED
  JOKI_UNASSIGNED
  JOB_PUBLISHED
  JOB_CANCELLED
  JOB_NOTIFICATION_RESENT
  JOB_CLAIMED
  PAYMENT_MARKED_PAID_MANUALLY
}

enum JokiStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum JokiAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum JokiRole {
  JUNGLE
  MID
  GOLD
  EXP
  ROAM
}

enum OrderAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum JobPostingStatus {
  OPEN
  CLAIMED
  CANCELLED
}

enum JokiActivityAction {
  TELEGRAM_LINKED
  TELEGRAM_UNLINKED_BY_ADMIN
  JOB_CLAIMED
  JOB_STARTED
}

model Order {
  id                   String        @id @default(cuid())
  publicId             String        @unique
  customerName         String
  whatsapp             String
  email                String?
  serviceMode          ServiceMode
  mlbbNickname         String?
  mlbbUserId           String?
  mlbbServerId         String?
  initialAbsoluteStar  Int
  targetAbsoluteStar   Int
  progressAbsoluteStar Int
  totalStars           Int
  subtotal             Int
  discount             Int           @default(0)
  total                Int
  currency             String        @default("IDR")
  status               OrderStatus   @default(AWAITING_PAYMENT)
  paymentStatus        PaymentStatus @default(PENDING)
  customerNotes        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  credentials          OrderCredential?
  events               OrderEvent[]
  paymentAttempts      PaymentAttempt[]
  auditLogs            AdminAuditLog[]
  assignments          OrderAssignment[]
  jobPostings          JobPosting[]
  jokiActivities       JokiActivityLog[]

  @@index([whatsapp])
  @@index([serviceMode])
  @@index([createdAt])
}

model OrderCredential {
  id                   String      @id @default(cuid())
  orderId              String      @unique
  loginMethod          LoginMethod
  identifierCiphertext String
  identifierIv         String
  identifierAuthTag    String
  secretCiphertext     String
  secretIv             String
  secretAuthTag        String
  accountIdCiphertext  String
  accountIdIv          String
  accountIdAuthTag     String
  serverIdCiphertext   String
  serverIdIv           String
  serverIdAuthTag      String
  notesCiphertext      String?
  notesIv              String?
  notesAuthTag         String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  order                Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderEvent {
  id            String          @id @default(cuid())
  orderId       String
  type          OrderEventType
  status        OrderStatus?
  publicMessage String
  createdAt     DateTime        @default(now())
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model PaymentAttempt {
  id                    String               @id @default(cuid())
  publicId              String               @unique
  orderId               String
  provider              PaymentProvider
  method                PaymentMethod
  status                PaymentAttemptStatus @default(PENDING)
  amount                Int
  currency              String
  providerInvoiceNumber String               @unique
  providerPaymentId     String?
  providerRequestId     String?
  checkoutUrl           String?
  expiresAt             DateTime?
  paidAt                DateTime?
  failedAt              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  order                 Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([provider, status, expiresAt])
}

model AdminAuditLog {
  id        String           @id @default(cuid())
  action    AdminAuditAction
  orderId   String?
  metadata  Json?
  createdAt DateTime         @default(now())
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([action, createdAt])
}

model Joki {
  id                  String           @id @default(cuid())
  publicId            String           @unique
  name                String
  whatsapp            String
  telegramUsername    String?
  telegramUserId      String?          @unique
  telegramLinkedAt    DateTime?
  peakAbsoluteStar    Int
  currentAbsoluteStar Int?
  roles               JokiRole[]
  heroPool            String[]
  serviceModes        ServiceMode[]
  status              JokiStatus       @default(ACTIVE)
  availability        JokiAvailability @default(AVAILABLE)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  assignments         OrderAssignment[]
  telegramLinkTokens  JokiTelegramLinkToken[]
  activityLogs        JokiActivityLog[]
  claimedJobPostings  JobPosting[]      @relation("JobPostingClaimedBy")

  @@index([whatsapp])
  @@index([status, availability])
  @@index([serviceModes], type: Gin)
  @@index([createdAt])
}

model OrderAssignment {
  id        String                @id @default(cuid())
  orderId   String
  jokiId    String
  status    OrderAssignmentStatus @default(ACTIVE)
  assignedAt DateTime             @default(now())
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  order     Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  joki      Joki                  @relation(fields: [jokiId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([jokiId, status])
  @@index([assignedAt])
}

model JokiTelegramLinkToken {
  id        String   @id @default(cuid())
  jokiId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  joki      Joki     @relation(fields: [jokiId], references: [id], onDelete: Cascade)

  @@index([jokiId, expiresAt])
}

model JobPosting {
  id              String           @id @default(cuid())
  publicId        String           @unique
  orderId         String
  status          JobPostingStatus @default(OPEN)
  publishedAt     DateTime         @default(now())
  claimedAt       DateTime?
  claimedByJokiId String?
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  claimedByJoki   Joki?            @relation("JobPostingClaimedBy", fields: [claimedByJokiId], references: [id], onDelete: SetNull)
  activities      JokiActivityLog[]

  @@index([orderId, status])
  @@index([status, publishedAt])
  @@index([claimedByJokiId])
}

model JokiActivityLog {
  id           String             @id @default(cuid())
  jokiId       String
  orderId      String?
  jobPostingId String?
  action       JokiActivityAction
  metadata     Json?
  createdAt    DateTime           @default(now())
  joki         Joki               @relation(fields: [jokiId], references: [id], onDelete: Cascade)
  order        Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  jobPosting   JobPosting?        @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  @@index([jokiId, createdAt])
  @@index([orderId, createdAt])
  @@index([jobPostingId, createdAt])
}
