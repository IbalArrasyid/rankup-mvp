generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  WAITING_JOKI
  ASSIGNED
  IN_PROGRESS
  PAUSED
  QC
  COMPLETED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum LoginMethod {
  MOONTON
  GOOGLE
  FACEBOOK
  TIKTOK
  OTHER
}

enum OrderEventType {
  ORDER_CREATED
  STATUS_CHANGED
  PAYMENT_UPDATED
  PROGRESS_UPDATED
  CREDENTIALS_RECEIVED
}

enum AdminAuditAction {
  ADMIN_LOGIN_SUCCESS
  ADMIN_LOGIN_FAILED
  PAYMENT_MARKED_PAID
  ORDER_STATUS_CHANGED
  ORDER_PROGRESS_UPDATED
  CREDENTIAL_REVEALED
  JOKI_CREATED
  JOKI_UPDATED
  JOKI_ASSIGNED
  JOKI_UNASSIGNED
}

enum JokiStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum JokiAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum JokiRole {
  JUNGLE
  MID
  GOLD
  EXP
  ROAM
}

enum OrderAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Order {
  id                   String        @id @default(cuid())
  publicId             String        @unique
  customerName         String
  whatsapp             String
  email                String?
  initialAbsoluteStar  Int
  targetAbsoluteStar   Int
  progressAbsoluteStar Int
  totalStars           Int
  subtotal             Int
  discount             Int           @default(0)
  total                Int
  currency             String        @default("IDR")
  status               OrderStatus   @default(AWAITING_PAYMENT)
  paymentStatus        PaymentStatus @default(PENDING)
  customerNotes        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  credentials          OrderCredential?
  events               OrderEvent[]
  auditLogs            AdminAuditLog[]
  assignments          OrderAssignment[]

  @@index([whatsapp])
  @@index([createdAt])
}

model OrderCredential {
  id                   String      @id @default(cuid())
  orderId              String      @unique
  loginMethod          LoginMethod
  identifierCiphertext String
  identifierIv         String
  identifierAuthTag    String
  secretCiphertext     String
  secretIv             String
  secretAuthTag        String
  accountIdCiphertext  String
  accountIdIv          String
  accountIdAuthTag     String
  serverIdCiphertext   String
  serverIdIv           String
  serverIdAuthTag      String
  notesCiphertext      String?
  notesIv              String?
  notesAuthTag         String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  order                Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderEvent {
  id            String          @id @default(cuid())
  orderId       String
  type          OrderEventType
  status        OrderStatus?
  publicMessage String
  createdAt     DateTime        @default(now())
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model AdminAuditLog {
  id        String           @id @default(cuid())
  action    AdminAuditAction
  orderId   String?
  metadata  Json?
  createdAt DateTime         @default(now())
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([action, createdAt])
}

model Joki {
  id                  String           @id @default(cuid())
  publicId            String           @unique
  name                String
  whatsapp            String
  telegramUsername    String?
  peakAbsoluteStar    Int
  currentAbsoluteStar Int?
  roles               JokiRole[]
  heroPool            String[]
  status              JokiStatus       @default(ACTIVE)
  availability        JokiAvailability @default(AVAILABLE)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  assignments         OrderAssignment[]

  @@index([whatsapp])
  @@index([status, availability])
  @@index([createdAt])
}

model OrderAssignment {
  id        String                @id @default(cuid())
  orderId   String
  jokiId    String
  status    OrderAssignmentStatus @default(ACTIVE)
  assignedAt DateTime             @default(now())
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  order     Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  joki      Joki                  @relation(fields: [jokiId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([jokiId, status])
  @@index([assignedAt])
}
